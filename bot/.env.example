# ---- Binance ----
# testnet: https://testnet.binance.vision (sahte para, önce burada deneyin)
# live:    https://api.binance.com (GERÇEK para)
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true iken hiçbir gerçek emir gönderilmez, işlemler simüle edilir.
# Gerçek emir için: DRY_RUN=false
DRY_RUN=true

# ---- Coin listesi ----
# Boş bırakılırsa: USDT paritelerinde 24 saatlik hacme göre ilk TOP_N coin (günde bir yenilenir).
# Stablecoin, fiat, wrapped varlıklar ve MIN_LISTING_DAYS'ten yeni listelenenler elenir.
# Sabit liste için örnek: SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SYMBOLS=
TOP_N=10
# Otomatik listeden ayrıca çıkarılacak coinler (ör. PEPE,DOGE)
EXCLUDE_ASSETS=
MIN_LISTING_DAYS=365
UNIVERSE_REFRESH_HOURS=24

# ---- Analiz ----
# Her coin, mum kapanışında 5 yöntemle değerlendirilir:
# Trend (EMA200), EMA 20/50, MACD, RSI, Bollinger. Her biri +1 / 0 / -1 oy verir.
KLINE_INTERVAL=4h
# Al/sat analizi ne sıklıkla yapılsın (dakika). 0 = sadece 4 saatlik mum kapanınca.
# >0 ise ayrıca her N dakikada bir, henüz kapanmamış mum anlık fiyatla hesaba katılır.
ANALYSIS_MINUTES=30
# Alım için gereken en az skor (1..5)
BUY_SCORE=3
# Bu skora veya altına düşünce pozisyon satılır (-5..0)
SELL_SCORE=-2
# true: sadece fiyat EMA200 üstündeyken alım
REQUIRE_TREND=true
# Bot döngüsü kaç saniyede bir çalışsın (zarar durdur kontrolü bu sıklıkta)
TICK_SECONDS=60

# ---- Risk ----
# Her pozisyona ayrılan quote miktarı (ör. USDT)
ORDER_QUOTE_AMOUNT=20
# Aynı anda en fazla açık pozisyon (toplam risk = bu × ORDER_QUOTE_AMOUNT)
MAX_OPEN_POSITIONS=5
# Günlük en fazla işlem (sadece alımları durdurur)
MAX_TRADES_PER_DAY=20
# Zarar durdur / kâr al yüzdeleri (0 = kapalı)
STOP_LOSS_PCT=8
TAKE_PROFIT_PCT=0

# ---- API sunucusu ----
HOST=127.0.0.1
PORT=8787
# /api/* uçları için zorunlu gizli token (uzun, rastgele bir değer)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_TOKEN=
# Tarayıcıdan erişim için izin verilen origin (ör. GitHub Pages siteniz)
ALLOWED_ORIGIN=https://kverd123.github.io
# Sunucu açılınca bot otomatik başlasın mı
AUTO_START=false

# ---- Telegram bildirimi (opsiyonel) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
