# ---- Binance ----
# testnet: https://testnet.binance.vision (sahte para, önce burada deneyin)
# live:    https://api.binance.com (GERÇEK para)
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true iken hiçbir gerçek emir gönderilmez, işlemler simüle edilir.
# Gerçek emir için: DRY_RUN=false
DRY_RUN=true

# ---- Strateji (SMA kesişimi, sadece long) ----
SYMBOL=BTCUSDT
KLINE_INTERVAL=15m
SMA_FAST=9
SMA_SLOW=21
# Bot döngüsü kaç saniyede bir çalışsın
TICK_SECONDS=60

# ---- Risk ----
# Her alımda harcanacak quote miktarı (ör. USDT)
ORDER_QUOTE_AMOUNT=20
# Günlük en fazla işlem (alım + satım) sayısı
MAX_TRADES_PER_DAY=10
# Zarar durdur / kâr al yüzdeleri (0 = kapalı)
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6

# ---- API sunucusu ----
HOST=127.0.0.1
PORT=8787
# /api/* uçları için zorunlu gizli token (uzun, rastgele bir değer)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_TOKEN=
# Tarayıcıdan erişim için izin verilen origin (ör. GitHub Pages siteniz)
ALLOWED_ORIGIN=https://kverd123.github.io
# Sunucu açılınca bot otomatik başlasın mı
AUTO_START=false

# ---- Telegram bildirimi (opsiyonel) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
