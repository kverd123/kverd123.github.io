{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "besyontem",
  "dry_run": true,
  "dry_run_wallet": 73,
  "trading_mode": "spot",
  "stake_currency": "USDT",
  "stake_amount": 10,
  "max_open_trades": 5,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "",
  "timeframe": "4h",
  "strategy": "BesYontem",
  "cancel_open_orders_on_exit": false,
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [],
    "pair_blacklist": [
      "(USDC|FDUSD|TUSD|USDP|DAI|BUSD|USD1|RLUSD|PYUSD|USDE|XUSD|U|EUR|EURI|AEUR|GBP|TRY|BRL|WBTC|WBETH|BETH)/.*",
      ".*(UP|DOWN|BULL|BEAR)/.*"
    ]
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 40,
      "sort_key": "quoteVolume",
      "refresh_period": 86400
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 365
    },
    {
      "method": "RangeStabilityFilter",
      "lookback_days": 10,
      "min_rate_of_change": 0.03
    },
    {
      "method": "OffsetFilter",
      "offset": 0,
      "number_assets": 10
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "internals": {
    "process_throttle_secs": 60
  }
}
